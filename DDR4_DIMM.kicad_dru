(version 1)
(rule "DRAM BGA pad clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.Type == 'Pad' && A.memberOfFootprint('U2')"))

(rule "DRAM BGA pad clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.Type == 'Pad' && A.memberOfFootprint('U3')"))

(rule "DRAM BGA pad clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.Type == 'Pad' && A.memberOfFootprint('U4')"))

(rule "DRAM BGA pad clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.Type == 'Pad' && A.memberOfFootprint('U5')"))

(rule "DRAM BGA pad clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.Type == 'Pad' && A.memberOfFootprint('U6')"))

(rule "DRAM BGA pad clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.Type == 'Pad' && A.memberOfFootprint('U7')"))

(rule "DRAM BGA pad clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.Type == 'Pad' && A.memberOfFootprint('U8')"))

(rule "DRAM BGA pad clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.Type == 'Pad' && A.memberOfFootprint('U9')"))


(rule "Termination resistor pad clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.Type == 'Pad' && A.memberOfFootprint('R*')"))
